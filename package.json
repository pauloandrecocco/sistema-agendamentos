{
  "name": "sistema-agendamentos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:shared": "npm run build -w @agenda/shared",
    "build:deps": "npm run build:shared && npm run db:generate -w api",
    "prebuild": "npm run db:generate -w api",
    "build": "npm run build --workspaces",
    "predev": "npm run build:deps",
    "dev": "concurrently -n shared,api,web -c blue,green,magenta \"npm run dev -w @agenda/shared\" \"npm run dev -w api\" \"npm run dev -w web\"",
    "pretypecheck": "npm run build:deps",
    "typecheck": "npm run typecheck --workspaces",
    "pretest": "npm run build:deps",
    "test": "npm run test --workspaces",
    "prelint": "npm run build:deps",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.1",
    "concurrently": "10.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
  }
}
